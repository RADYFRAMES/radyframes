# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Public values (safe in the browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
# Optional owner-provided HTTPS MP4/WebM URL or /public video path for the homepage hero.
NEXT_PUBLIC_HERO_VIDEO_URL=
# Secret. Server-only. Used by the local portfolio importer, never expose as NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub App installation access for server-side project thumbnail storage.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
GITHUB_DEPLOYMENT_BRANCH=
